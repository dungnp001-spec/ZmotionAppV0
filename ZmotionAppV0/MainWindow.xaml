<Window
    x:Class="ZmotionAppV0.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZmotionAppV0"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PC control App"
    Width="1200"
    Height="700"
    MinWidth="900"
    MinHeight="500"
    Background="{StaticResource AppBgBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ===== Header =====  -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="20,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Z" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="VALEN" />
                </StackPanel>

                <!--  Alarm  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource OnDarkMutedBrush}"
                        Text="CẢNH BÁO:" />
                    <!--  TODO cách 2: khi nối dữ liệu, chuyển Foreground + Text thành style cục bộ có DataTrigger  -->
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SuccessBrush}"
                        Text="Không có lỗi" />
                </StackPanel>

                <!--  Header actions  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="ClockTextBlock"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="00:00:00" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== Main content =====  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!--  Navigation  -->
            <Border Grid.Column="0" Background="{StaticResource NavBgBrush}">
                <DockPanel>
                    <TextBlock
                        Margin="20,18,20,10"
                        DockPanel.Dock="Top"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NavTitleBrush}"
                        Text="ĐIỀU HƯỚNG" />
                    <StackPanel>
                        <Button Content="Trang chủ" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Content="Điều khiển" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Content="Giám sát" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Content="Cấu hình" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Content="Lịch sử" Style="{StaticResource NavigationButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Current page  -->
            <Border
                Grid.Column="1"
                Margin="12"
                Style="{StaticResource PanelStyle}">
                <ContentControl
                    x:Name="CurrentPage"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="{StaticResource TextPlaceholderBrush}"
                            Text="Trang hiện tại" />
                    </Grid>
                </ContentControl>
            </Border>

            <!--  Stautus panel  -->
            <Border
                Grid.Column="2"
                Margin="0,12,12,12"
                Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="TRẠNG THÁI" />
                    <Separator Margin="16,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource PanelTitleStyle}"
                        Text="AXIS ENABLE" />
                    <Ellipse
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Fill="{StaticResource False}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ===== Status bar =====  -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="12,0"
                    Style="{StaticResource StatusTextStyle}"
                    Text="THANH TRẠNG THÁI" />

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Orientation="Horizontal">
                    <!--  TODO cách 2: xanh khi đã kết nối, đỏ khi mất kết nối  -->
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        Style="{StaticResource StatusTextStyle}"
                        Text="Đã kết nối" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
