<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Nền  -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B2147" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#102A52" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#263238" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E0E5EA" />

    <!--  Màu nhấn / trạng thái  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E53935" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#EF5350" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#66BB6A" />
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="#43A047" />
    <SolidColorBrush x:Key="False" Color="Gray" />
    <SolidColorBrush x:Key="True" Color="#43A047" />

    <!--  Chữ trên nền sáng  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#263238" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#607D8B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#78909C" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#90A4AE" />

    <!--  Chữ trên nền tối (header, nav, status bar)  -->
    <SolidColorBrush x:Key="OnDarkBrush" Color="#CFD8DC" />
    <SolidColorBrush x:Key="OnDarkMutedBrush" Color="#B8C7DC" />
    <SolidColorBrush x:Key="NavTitleBrush" Color="#8FA7C7" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#D7E2F2" />
</ResourceDictionary>
